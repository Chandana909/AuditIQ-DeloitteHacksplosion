            "modelName": "qwen3.5-35b-hacksplosion",
            "temperature": 0.9,
            "streaming": true,
            "maxTokens": "",
            "topP": "",
            "timeout": "",
            "allowImageUploads": "",
            "imageResolution": "low",
            "modelOptions": "",
            "agentModel": "chatLitellm"
          }
